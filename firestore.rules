rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBlocked(userA, userB) {
      return exists(/databases/$(database)/documents/users/$(userA)/blocks/$(userB)) ||
             exists(/databases/$(database)/documents/users/$(userB)/blocks/$(userA));
    }

    // Helper to verify that initial document creation does not assign privileged or server-managed values
    function hasNoPrivilegeEscalation(data) {
      return (!('role' in data) || data.role == 'user') &&
             (!('isPremium' in data) || data.isPremium == false) &&
             (!('premiumExpiry' in data) || data.premiumExpiry == null) &&
             (!('isVerified' in data) || data.isVerified == false) &&
             (!('verifiedExpiry' in data) || data.verifiedExpiry == null) &&
             (!('followersCount' in data) || data.followersCount == 0) &&
             (!('followingCount' in data) || data.followingCount == 0) &&
             (!('dailyConnections' in data) || data.dailyConnections == 0) &&
             (!('monthlyConnections' in data) || data.monthlyConnections == 0);
    }

    // Helper to prevent decreasing connection quotas within the same active day/month window
    function hasNoQuotaReset(oldData, newData) {
      return (!('dailyConnections' in newData) || !('dailyConnections' in oldData) ||
              !('dailyConnectionsDate' in newData) || !('dailyConnectionsDate' in oldData) ||
              newData.dailyConnectionsDate != oldData.dailyConnectionsDate ||
              newData.dailyConnections >= oldData.dailyConnections) &&
             (!('monthlyConnections' in newData) || !('monthlyConnections' in oldData) ||
              !('monthlyConnectionsMonth' in newData) || !('monthlyConnectionsMonth' in oldData) ||
              newData.monthlyConnectionsMonth != oldData.monthlyConnectionsMonth ||
              newData.monthlyConnections >= oldData.monthlyConnections);
    }

    // Collection group read rule for 'follows' queries (e.g. followers count aggregation)
    match /{path=**}/follows/{followId} {
      allow read: if isSignedIn();
    }

    // Public User Profiles Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && hasNoPrivilegeEscalation(request.resource.data);
      allow update: if isSignedIn() && isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'isPremium',
          'premiumExpiry',
          'isVerified',
          'verifiedExpiry',
          'followersCount',
          'followingCount',
          'dailyConnections',
          'dailyConnectionsDate',
          'monthlyConnections',
          'monthlyConnectionsMonth'
        ]);
      allow delete: if isOwner(userId);

      // Private Settings Sub-collection (Owner Only, Protected against Privilege Escalation & Quota Resets)
      match /private/{settingId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          !request.resource.data.keys().hasAny([
            'role',
            'isPremium',
            'premiumExpiry',
            'isVerified',
            'verifiedExpiry',
            'followersCount',
            'followingCount'
          ]);
        allow update: if isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role',
            'isPremium',
            'premiumExpiry',
            'isVerified',
            'verifiedExpiry',
            'followersCount',
            'followingCount'
          ]) &&
          hasNoQuotaReset(resource.data, request.resource.data);
        allow delete: if isOwner(userId);
      }

      // Follows Sub-collection (Owner can only manage their own follows; self-follow forbidden)
      match /follows/{targetId} {
        allow read: if isSignedIn();
        allow create: if isOwner(userId) && targetId != userId;
        allow delete: if isOwner(userId);
      }

      // Blocks Sub-collection (Owner Only)
      match /blocks/{targetId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Notifications Sub-collection
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isSignedIn() && (
          // 1. Owner creating notifications for themselves (e.g. system, account events)
          (isOwner(userId) && request.resource.data.userId == userId) ||
          // 2. Authenticated other user creating authorized peer interaction notifications
          (!isOwner(userId) &&
           request.resource.data.userId == userId &&
           request.resource.data.fromUserId == request.auth.uid &&
           request.resource.data.type in [
             'crush', 'crushComment', 'commentReply', 'follow',
             'connectionRequest', 'connectionAccepted', 'connectionDeclined',
             'message', 'mention', 'locationPost'
           ])
        );
      }
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['crushCount', 'crushesCount', 'crushedUserIds'])
      );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Likes Sub-collection
      match /likes/{userId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }

      // Comments Sub-collection
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }

    // Helper to extract receiver/recipient UID from connection data
    function getConnectionRecipient(data) {
      return ('receiverId' in data && data.receiverId != '') ? data.receiverId : (
        'recipientId' in data ? data.recipientId : ''
      );
    }

    // Helper to get the other participant in a 2-person connection
    function getOtherParticipant(data, currentUid) {
      return data.senderId == currentUid ? getConnectionRecipient(data) : data.senderId;
    }

    // Helper to check if a user is one of the valid participants of a connection
    function isConnectionParticipant(data, uid) {
      return ('participants' in data && uid in data.participants) ||
             ('senderId' in data && data.senderId == uid) ||
             ('receiverId' in data && data.receiverId == uid) ||
             ('recipientId' in data && data.recipientId == uid);
    }

    // Connections Collection (Participants Only, Immutable Members & Strict Counter/Preview Integrity)
    match /connections/{connectionId} {
      allow read: if isSignedIn() && isConnectionParticipant(resource.data, request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        'participants' in request.resource.data &&
        request.resource.data.participants.size() == 2 &&
        request.auth.uid in request.resource.data.participants &&
        getConnectionRecipient(request.resource.data) != '' &&
        getConnectionRecipient(request.resource.data) != request.auth.uid &&
        (getConnectionRecipient(request.resource.data) in request.resource.data.participants) &&
        !isBlocked(request.auth.uid, getConnectionRecipient(request.resource.data));

      allow update: if isSignedIn() &&
        isConnectionParticipant(resource.data, request.auth.uid) &&
        // Participants list is strictly immutable - clients cannot add 3rd parties
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.senderId == resource.data.senderId &&
        (!('receiverId' in resource.data) || request.resource.data.receiverId == resource.data.receiverId) &&
        (!('recipientId' in resource.data) || request.resource.data.recipientId == resource.data.recipientId) &&
        (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
        (!('id' in resource.data) || request.resource.data.id == resource.data.id) &&
        (!('postId' in resource.data) || request.resource.data.postId == resource.data.postId) &&
        (!('amount' in resource.data) || request.resource.data.amount == resource.data.amount) &&
        (!('isPaid' in resource.data) || request.resource.data.isPaid == resource.data.isPaid) && (
          // 1. Message Send Update (last-message metadata & recipient unread increment)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastMessageText', 'lastMessageTimestamp', 'lastMessageSenderId', 'updatedAt', 'unreadCounts'
            ]) &&
            // Sender identity of the last message MUST match the authenticated sender
            request.resource.data.lastMessageSenderId == request.auth.uid &&
            request.resource.data.lastMessageText is string &&
            request.resource.data.lastMessageText.size() <= 1000 &&
            // Sender cannot increment or change their own unread count
            (!('unreadCounts' in request.resource.data) || (
              request.resource.data.unreadCounts.keys().hasOnly(resource.data.participants) &&
              (!(request.auth.uid in request.resource.data.unreadCounts) ||
                request.resource.data.unreadCounts[request.auth.uid] == (
                  ('unreadCounts' in resource.data && request.auth.uid in resource.data.unreadCounts) ? resource.data.unreadCounts[request.auth.uid] : 0
                )
              ) &&
              // Recipient unread count can only increment by 1 or initialize to 1
              (!(getOtherParticipant(resource.data, request.auth.uid) in request.resource.data.unreadCounts) ||
                request.resource.data.unreadCounts[getOtherParticipant(resource.data, request.auth.uid)] == (
                  ('unreadCounts' in resource.data && getOtherParticipant(resource.data, request.auth.uid) in resource.data.unreadCounts)
                    ? resource.data.unreadCounts[getOtherParticipant(resource.data, request.auth.uid)] + 1
                    : 1
                )
              )
            ))
          ) ||
          // 2. Mark as read (Caller can ONLY reset their own unread count to 0)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadCounts']) &&
            request.resource.data.unreadCounts.keys().hasOnly(resource.data.participants) &&
            request.resource.data.unreadCounts[request.auth.uid] == 0 &&
            // Other participant's unread count MUST be untouched
            (!(getOtherParticipant(resource.data, request.auth.uid) in request.resource.data.unreadCounts) ||
              request.resource.data.unreadCounts[getOtherParticipant(resource.data, request.auth.uid)] == (
                ('unreadCounts' in resource.data && getOtherParticipant(resource.data, request.auth.uid) in resource.data.unreadCounts)
                  ? resource.data.unreadCounts[getOtherParticipant(resource.data, request.auth.uid)]
                  : 0
              )
            )
          ) ||
          // 3. Status Response (Recipient accepts or declines a pending request)
          (
            request.auth.uid == getConnectionRecipient(resource.data) &&
            resource.data.status == 'pending' &&
            request.resource.data.status in ['accepted', 'declined'] &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'respondedAt'])
          ) ||
          // 4. Account Deletion Anonymization (Phase 5)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'senderUsername', 'senderProfilePic',
              'receiverUsername', 'receiverProfilePic',
              'recipientUsername', 'recipientProfilePic',
              'lastMessageText', 'updatedAt'
            ]) &&
            request.resource.data.lastMessageText == 'Conversation closed (user deleted account)'
          )
        );

      allow delete: if false;

      // Messages Sub-collection
      match /messages/{messageId} {
        allow read: if isSignedIn() && isConnectionParticipant(
          get(/databases/$(database)/documents/connections/$(connectionId)).data,
          request.auth.uid
        );
        
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          isConnectionParticipant(
            get(/databases/$(database)/documents/connections/$(connectionId)).data,
            request.auth.uid
          ) &&
          request.resource.data.connectionId == connectionId &&
          request.resource.data.isRead == false &&
          request.resource.data.isDeletedForEveryone == false &&
          (!('deletedForUserIds' in request.resource.data) || request.resource.data.deletedForUserIds.size() == 0) &&
          !isBlocked(
            request.resource.data.senderId,
            getConnectionRecipient(request.resource.data)
          );

        // Granular Message Updates
        allow update: if isSignedIn() &&
          isConnectionParticipant(
            get(/databases/$(database)/documents/connections/$(connectionId)).data,
            request.auth.uid
          ) &&
          request.resource.data.senderId == resource.data.senderId &&
          request.resource.data.connectionId == resource.data.connectionId &&
          (!('receiverId' in resource.data) || request.resource.data.receiverId == resource.data.receiverId) &&
          (!('recipientId' in resource.data) || request.resource.data.recipientId == resource.data.recipientId) &&
          (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
          (!('timestamp' in resource.data) || request.resource.data.timestamp == resource.data.timestamp) && (
            // 1. Delete for everyone (Original Sender ONLY with exact soft deletion payload)
            (
              resource.data.senderId == request.auth.uid &&
              request.resource.data.isDeletedForEveryone == true &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeletedForEveryone', 'content', 'message', 'mediaUrl']) &&
              request.resource.data.content == 'This message was deleted' &&
              request.resource.data.message == 'This message was deleted' &&
              request.resource.data.mediaUrl == null
            ) ||
            // 2. Delete for me (Self UID appended to deletedForUserIds ONLY, existing UIDs preserved)
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedForUserIds']) &&
              request.resource.data.deletedForUserIds.hasAll(resource.data.deletedForUserIds) &&
              request.auth.uid in request.resource.data.deletedForUserIds &&
              (
                request.resource.data.deletedForUserIds.size() == resource.data.deletedForUserIds.size() ||
                request.resource.data.deletedForUserIds.size() == resource.data.deletedForUserIds.size() + 1
              )
            ) ||
            // 3. Mark as read (Intended Recipient ONLY)
            (
              (resource.data.receiverId == request.auth.uid || resource.data.recipientId == request.auth.uid) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'deliveryStatus']) &&
              request.resource.data.isRead is bool &&
              request.resource.data.deliveryStatus in ['sent', 'delivered', 'read']
            )
          );

        allow delete: if false;
      }
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Direct Notifications Collection (Backward-compatibility)
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // Reports Collection (Privacy-Protected, Client Write-Only, Validated Payloads)
    match /reports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.targetType in ['user', 'post', 'comment', 'message'] &&
        request.resource.data.targetId is string &&
        request.resource.data.targetId.size() > 0 &&
        request.resource.data.targetId.size() <= 128 &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.reason.size() <= 100 &&
        (!('explanation' in request.resource.data) || request.resource.data.explanation == null || (request.resource.data.explanation is string && request.resource.data.explanation.size() <= 2000)) &&
        (!('targetPreview' in request.resource.data) || request.resource.data.targetPreview == null || (request.resource.data.targetPreview is string && request.resource.data.targetPreview.size() <= 500));
      allow read, update, delete: if false;
    }
  }
}



